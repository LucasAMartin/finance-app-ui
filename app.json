{
  "expo": {
    "name": "finance-app",
    "slug": "finance-app",
    "scheme": "financeapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow finance-app to recognize speech so you can add expenses hands-free.",
        "NSMicrophoneUsageDescription": "Allow finance-app to use the microphone to log expenses by voice.",
        "NSFaceIDUsageDescription": "Use Face ID to keep your financial information private.",
        "NSPhotoLibraryUsageDescription": "Choose a photo from your library to use as your profile picture or app background.",
        "ITSAppUsesNonExemptEncryption": false,
        "CKSharingSupported": true
      },
      "entitlements": {
        "com.apple.developer.icloud-container-identifiers": [
          "iCloud.com.lucasmartin.financeapp"
        ],
        "com.apple.developer.icloud-extended-share-access": [],
        "com.apple.developer.icloud-services": [
          "CloudKit"
        ],
        "com.apple.developer.ubiquity-container-identifiers": [
          "iCloud.com.lucasmartin.financeapp"
        ]
      },
      "bundleIdentifier": "com.lucasmartin.financeapp"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withApplePayTransactionIntent",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a photo from your library to use as your profile picture or app background."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow finance-app to use the microphone to log expenses by voice.",
          "speechRecognitionPermission": "Allow finance-app to recognize speech so you can add expenses hands-free."
        }
      ],
      "expo-font",
      "expo-sqlite",
      "expo-status-bar",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to keep your financial information private."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-screen.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-router",
      "expo-image",
      [
        "expo-notifications",
        {
          "enableBackgroundRemoteNotifications": true
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "buildReactNativeFromSource": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "1763f437-ae34-458a-b522-5ab5ab6b3535"
      }
    }
  }
}
